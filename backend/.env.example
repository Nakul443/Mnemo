GEMINI_API_KEY=your_key_from_ai_studio
# Verify current free-tier model names in Google AI Studio; these change.
EXTRACTION_MODEL=gemini-2.5-flash-lite
CONFLICT_MODEL=gemini-2.5-flash-lite
CHAT_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call the API (Day 3 dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
FALKORDB_SSL=false
FALKORDB_GRAPH=mnemo

# Or FalkorDB Cloud full connection URI (preferred for Vercel/Cloud):
# FALKORDB_URL=rediss://default:YOUR_PASSWORD@YOUR_CLOUD_HOST:PORT

AGENT_ID=agent_main
AGENT_NAME=Mnemo
LOG_LEVEL=INFO
PORT=8000

